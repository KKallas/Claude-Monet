{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	# Who came, for what, and what they got: `docker compose logs caddy`. An agent link is a key and a card link sets
	# a password, so any long token in the path is struck out and everything after a "?" is left off (a Note can
	# travel there too): the log is not a list of keys.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "[A-Za-z0-9_-]{24,}|\?.*$" "<hidden>"
				request>headers>Referer delete
				request>tls delete
				resp_headers delete
			}
		}
	}
	reverse_proxy app:8080
}
