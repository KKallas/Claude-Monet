# /opt/monet/.env on the droplet
DOMAIN=monet.example.org
MONET_MAX_USERS=20
MONET_NOTE=Test instance: things change daily, and files here are not kept the way a customer's would be.
# APP_MEM=1500m             # the web app, below the droplet's memory (no Note is built here: agents build them)
# CPUS=1.0
# Shared studies (/s/<link>) are watched by people signed in with GitHub: an OAuth App's id and secret
# (docs/SETUP-ONLINE.md, "Sharing a study"). Without them, a link can be made but not opened.
# MONET_GITHUB_ID=Ov23li...
# MONET_GITHUB_SECRET=...
