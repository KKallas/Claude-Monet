# /opt/monet/.env on the droplet
DOMAIN=monet.example.org
MONET_MAX_USERS=20
MONET_NOTE=Test instance: things change daily, and files here are not kept the way a customer's would be.
# APP_MEM=700m              # the web app
# RUNNER_MEM=1300m          # the container that builds the Notes; together below the droplet's memory
# CPUS=1.0
# MONET_BUILD_TIMEOUT=120   # seconds one Note may take to build
# MONET_COLD=1              # start every build from nothing (seconds slower): only if warm builds give trouble
